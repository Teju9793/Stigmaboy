# ============================================
# STIGMABOY — Environment Variables
# Copy this file to .env.local and fill values
# NEVER commit .env.local to version control
# ============================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # SERVER ONLY — NEVER expose to browser

# --- Razorpay ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx  # Client-side checkout only
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-here          # SERVER ONLY — NEVER expose to browser
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here       # SERVER ONLY

# --- Resend (Email) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx      # SERVER ONLY

# --- App Configuration ---
NEXT_PUBLIC_APP_URL=https://stigmaboy.com
NEXT_PUBLIC_CREATOR_INSTAGRAM=https://instagram.com/stigmaboy
NEXT_PUBLIC_CREATOR_YOUTUBE=https://youtube.com/@stigmaboy

# --- Upstash Redis (Rate Limiting) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here       # SERVER ONLY

# --- Admin ---
ADMIN_EMAIL=admin@stigmaboy.com
